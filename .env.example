# GEMINI_API_KEY: Fallback AI Provider key.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GROQ_API_KEY: Secret key for Groq Cloud API (Primary AI Provider).
# AI Studio automatically injects this at runtime from user secrets.
GROQ_API_KEY=

# Supabase PostgreSQL Configuration (Server-Side Only)
# Used for real user accounts, auth identities, sessions, and role profiles.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 Web Client Configuration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# VITE_GOOGLE_CLIENT_ID: Frontend-safe public client ID passed to Google Identity Services SDK
# GOOGLE_CLIENT_ID: Server-side client ID used by Express to verify ID token audience
# (Both typically have the same value, e.g. "1234567890-abc...apps.googleusercontent.com")
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Groq Model Configuration (Primary AI Provider)
# Production model for fast agronomic reasoning
GROQ_MODEL=openai/gpt-oss-120b
# Groq multimodal vision model for leaf/crop diagnostic images
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# Optional Groq circuit breaker settings
GROQ_CB_429_THRESHOLD=2
GROQ_CB_COOLDOWN_MS=60000
GROQ_TIMEOUT_MS=25000

# Gemini Model Strategy Configuration (Fallback AI Provider)
# Primary Gemini model defaults to gemini-3.1-flash-lite
PRIMARY_GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback Gemini model defaults to gemini-3.8-flash for resilience
FALLBACK_GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini 429 rate limit circuit breaker settings
GEMINI_CB_429_THRESHOLD=2
GEMINI_CB_COOLDOWN_MS=60000
GEMINI_TIMEOUT_MS=25000

