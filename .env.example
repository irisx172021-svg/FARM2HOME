# GEMINI_API_KEY: Fallback AI Provider key.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GROQ_API_KEY: Secret key for Groq Cloud API (Primary AI Provider).
# AI Studio automatically injects this at runtime from user secrets.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Groq Model Configuration (Primary AI Provider)
# Production model for fast agronomic reasoning
GROQ_MODEL=openai/gpt-oss-120b
# Groq multimodal vision model for leaf/crop diagnostic images
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# Optional Groq circuit breaker settings
GROQ_CB_429_THRESHOLD=2
GROQ_CB_COOLDOWN_MS=60000
GROQ_TIMEOUT_MS=25000

# Gemini Model Strategy Configuration (Fallback AI Provider)
# Primary Gemini model defaults to gemini-3.1-flash-lite
PRIMARY_GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback Gemini model defaults to gemini-3.8-flash for resilience
FALLBACK_GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini 429 rate limit circuit breaker settings
GEMINI_CB_429_THRESHOLD=2
GEMINI_CB_COOLDOWN_MS=60000
GEMINI_TIMEOUT_MS=25000

